# Configuration for docker-compose.yml. Copy to deploy/agentcore.toml.

[server]
bind = "0.0.0.0:8080"
# How sandboxes reach agentcore over the internal network.
gateway_url = "http://agentcore:8080"
ui_dir = "/opt/agentcore/web/dist"

# Required when binding to a non-loopback address.
# Generate with: docker compose run --rm agentcore hash-token '<token>'
[[server.operators]]
name = "admin"
token_sha256 = "REPLACE_WITH_64_HEX_CHARS_000000000000000000000000000000000000000"
role = "admin"           # admin: settings & API keys; operator: run/approve/stop; viewer: watch

[database]
# PostgreSQL. $AGENTCORE_DATABASE_URL (or $DATABASE_URL) overrides this.
url = "postgres://agentcore@postgres/agentcore"

[secrets]
# Master key that encrypts model provider API keys in the database.
# Generated on first start; $AGENTCORE_MASTER_KEY (base64, 32 bytes) overrides.
# BACK IT UP: without it stored API keys cannot be decrypted.
# master_key_file = "data/master.key"

[model_gateway]
# Keep full LLM request/response bodies (EU AI Act Art. 12). Hashes are always kept.
log_bodies = true
max_logged_body_bytes = 1048576

[storage]
data_dir = "/srv/agentcore/data"   # must equal $AGENTCORE_DATA
audit_fsync = true
audit_retention_days = 183

[policies]
dir = "/etc/agentcore/policies"
default = "default"

[sandbox]
backend = "docker"

[sandbox.docker]
image = "agentcore-sandbox:latest"
network = "agentcore-sandbox"
# runtime = "runsc"   # install gVisor on the host and enable for untrusted agents
memory = "4g"
cpus = "2"
pids_limit = 512

[transparency]
system_name = "agentcore"
provider = "Your organisation"
contact = "ai-oversight@example.com"
intended_purpose = "AI coding agents working as supervised collaborators on our repositories."

[[agents]]
name = "opencode"
adapter = "opencode"
description = "opencode with all side effects routed through agentcore."
policy = "default"
# Model API keys: add providers under Settings in the web UI (admin role).
